			"contents": "package com.social.api.controller;\n\nimport org.springframework.http.ResponseEntity;\nimport org.springframework.security.core.Authentication;\nimport org.springframework.web.bind.annotation.*;\nimport com.social.api.entity.Post;\nimport com.social.api.service.PostService;\nimport java.util.List;\nimport java.util.Map;\n\n@RestController\n@RequestMapping(\"/posts\")\npublic class PostController\n{\n    private final PostService postService;\n    \n    public PostController(PostService postService)\n    {\n        this.postService = postService;\n    }\n    \n    // PUBLIC ENDPOINTS\n    \n    // Get all public posts (feed)\n    @GetMapping(\"/public\")\n    public List<Post> getAllPublicPosts()\n    {\n        return postService.getAllPublicPosts();\n    }\n    \n    // Get user's public posts\n    @GetMapping(\"/user/{username}\")\n    public List<Post> getUserPublicPosts(@PathVariable String username)\n    {\n        return postService.getPublicPostsByUsername(username);\n    }\n    \n    // Get single post (if public)\n    @GetMapping(\"/{id}/public\")\n    public ResponseEntity<Post> getPublicPost(@PathVariable Long id)\n    {\n        return postService.getPostById(id)\n            .filter(post -> !post.isPrivate())\n            .map(ResponseEntity::ok)\n            .orElse(ResponseEntity.notFound().build());\n    }\n    \n    // PROTECTED ENDPOINTS\n    \n    // Get my private posts\n    @GetMapping(\"/private\")\n    public List<Post> getMyPrivatePosts(Authentication auth)\n    {\n        return postService.getPrivatePostsByUsername(auth.getName());\n    }\n    \n    // Get all my posts (public + private)\n    @GetMapping(\"/my\")\n    public List<Post> getMyAllPosts(Authentication auth)\n    {\n        return postService.getAllPostsByUsername(auth.getName());\n    }\n    \n    // Create post\n    @PostMapping\n    public ResponseEntity<Post> createPost(\n        @RequestBody CreatePostRequest request,\n        Authentication auth)\n    {\n        Post post = postService.createPost(\n            auth.getName(),\n            request.getContent(),\n            request.isPrivate()\n        );\n        return ResponseEntity.ok(post);\n    }\n    \n    // Update post\n    @PutMapping(\"/{id}\")\n    public ResponseEntity<Post> updatePost(\n        @PathVariable Long id,\n        @RequestBody UpdatePostRequest request,\n        Authentication auth)\n    {\n        if (!postService.isPostOwner(id, auth.getName()))\n        {\n            return ResponseEntity.status(403).build();\n        }\n        \n        Post updated = postService.updatePost(\n            id,\n            request.getContent(),\n            request.getIsPrivate()\n        );\n        return ResponseEntity.ok(updated);\n    }\n    \n    // Delete post\n    @DeleteMapping(\"/{id}\")\n    public ResponseEntity<?> deletePost(\n        @PathVariable Long id,\n        Authentication auth)\n    {\n        if (!postService.isPostOwner(id, auth.getName()))\n        {\n            return ResponseEntity.status(403).build();\n        }\n        \n        postService.deletePost(id);\n        return ResponseEntity.ok().build();\n    }\n    \n    // Get post count for current user\n    @GetMapping(\"/my/count\")\n    public Map<String, Long> getMyPostCount(Authentication auth)\n    {\n        long total = postService.getPostCount(auth.getName());\n        long publicCount = postService.getPublicPostCount(auth.getName());\n        return Map.of(\n            \"total\", total,\n            \"public\", publicCount,\n            \"private\", total - publicCount\n        );\n    }\n    \n    // DTOs for request bodies\n    public static class CreatePostRequest\n    {\n        private String content;\n        private boolean isPrivate;\n        \n        public String getContent()\n        {\n            return content;\n        }\n        \n        public void setContent(String content)\n        {\n            this.content = content;\n        }\n        \n        public boolean isPrivate()\n        {\n            return isPrivate;\n        }\n        \n        public void setPrivate(boolean isPrivate)\n        {\n            this.isPrivate = isPrivate;\n        }\n    }\n    \n    public static class UpdatePostRequest\n    {\n        private String content;\n        private Boolean isPrivate;\n        \n        public String getContent()\n        {\n            return content;\n        }\n        \n        public void setContent(String content)\n        {\n            this.content = content;\n        }\n        \n        public Boolean getIsPrivate()\n        {\n            return isPrivate;\n        }\n        \n        public void setIsPrivate(Boolean isPrivate)\n        {\n            this.isPrivate = isPrivate;\n        }\n    }\n}",
